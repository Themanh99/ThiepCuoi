# Chép thành .env rồi sửa
# Domain phải trỏ về server. Nhiều domain thì cách nhau bằng dấu cách và đặt trong ngoặc kép
SERVER_NAME=thiep.example.com
# Email nhận thông báo từ Let's Encrypt (có thể để trống)
LE_EMAIL=
# Let's Encrypt xác thực qua cổng 80 nên HTTP_PORT phải giữ 80, trừ khi có proxy phía trước chuyển tiếp vào
HTTP_PORT=80
HTTPS_PORT=443
# Thư mục certbot ghi fullchain.pem và privkey.pem
CERT_DIR=./docker/nginx/certs
